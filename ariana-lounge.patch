+bool ArianaLounge::isLyricText(const QString &text)
+{
+    const QString lower = text.toLower();
+    for (const auto &fragment : allLyrics())
+    {
+        if (!fragment.isEmpty() && lower.contains(fragment.toLower()))
+        {
+            return true;
+        }
+    }
+    return false;
