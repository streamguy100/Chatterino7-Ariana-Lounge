+            nullptr, "Load Ariana look", QString(),
+            "JSON files (*.json)");
+        if (path.isEmpty())
+        {
+            return;
+        }
+        QFile file(path);
+        if (!file.open(QIODevice::ReadOnly | QIODevice::Text))
+        {
+            return;
+        }
+        const QJsonObject look =
+            QJsonDocument::fromJson(file.readAll()).object();
+        const QString album = look.value("album").toString();
+        if (ArianaLounge::isAlbum(album))
+        {
+            ArianaLounge::applyAlbum(album);
+        }
+        getSettings()->arianaTickerEnabled.setValue(
+            look.value("ticker").toBool(true));
+        getSettings()->arianaChipsEnabled.setValue(
+            look.value("chips").toBool(true));
+        getSettings()->arianaSparklesEnabled.setValue(
+            look.value("sparkles").toBool(false));
+        getSettings()->arianaShelfEnabled.setValue(
+            look.value("shelf").toBool(true));
+    });
+    layout->addWidget(loadLookButton);
+
+    auto *note = new QLabel(
+        "Not in this build, on purpose: tab groups and pinned chats "
+        "need Notebook internals (protected in stock Chatterino — the "
+        "exact failure from the Fold build), per-split colours need a "
+        "per-split theme engine, live-toast styling needs the "
+        "notification widget, and Ctrl+F search keeps the stock search "
+        "as-is. Those were dropped rather than rewiring stock behaviour. "
+        "Live notifications still use your one-toggle rule (Enable "
+        "Toasts + Notify on any channel, list empty).",
+        this);
+    note->setWordWrap(true);
+    layout->addWidget(note);
+
+    layout->addStretch();
+}
+
+}  // namespace chatterino
