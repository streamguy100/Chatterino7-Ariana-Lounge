+#pragma once
+
+#include <QPixmap>
+#include <QWidget>
+
+class QTimer;
+
+namespace chatterino {
+
+/// Ariana Lounge loading screen — additive only, shows on every app open.
+///
+/// Shows sir's supplied image ("ARIANA GRANDE CHATTERINO 7TV", Ariana
+/// Grande in a purple stage outfit on a round platform) full-window
+/// over the Main window, then fades it out: 100% opacity at 0s, 75%
+/// at 1s, 50% at 2s, 25% at 3s, 0% (gone) at 4s — a 1-second QTimer
+/// stepping the opacity by 0.25 each tick, plus a hard 4-second
+/// fallback that hides it no matter what, so it can NEVER stick on
+/// loading and block the chats. The chats load underneath while it
+/// fades; it does not delay or block startup, and mouse events pass
+/// straight through it (WA_TransparentForMouseEvents).
+///
+/// If the image resource is missing, it hides immediately instead of
+/// showing a black screen.
+class ArianaLoadingScreen : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit ArianaLoadingScreen(QWidget *parent = nullptr);
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void stepFade();
+    void finish();
+
+    QPixmap pixmap_;
+    QTimer *stepTimer_ = nullptr;
+    qreal opacity_ = 1.0;
+    int step_ = 0;
+    bool finished_ = false;
+};
+
+}  // namespace chatterino
