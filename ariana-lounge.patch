+void ArianaLounge::applyAlbum(const QString &album)
+{
+    if (!isAlbum(album))
+    {
+        return;
+    }
+    getSettings()->arianaCurrentAlbum.setValue(album);
+    getTheme()->themeName.setValue(themeKey(album));
+}
