+
+/// /lyric — show a random lyric fragment for the current album as a
+/// system message. Nothing is sent; tap a chip to insert it.
+QString arianaLyric(const CommandContext &ctx);
+
+/// /ariana — open the Ariana Settings page.
+QString arianaOpenSettings(const CommandContext &ctx);
+
+}  // namespace commands
+
+}  // namespace chatterino
