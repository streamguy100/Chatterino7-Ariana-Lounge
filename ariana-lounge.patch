diff --git a/src/controllers/commands/builtin/ArianaCommands.cpp b/src/controllers/commands/builtin/ArianaCommands.cpp
new file mode 100644
index 000000000..b0d0bd21b
--- /dev/null
+++ b/src/controllers/commands/builtin/ArianaCommands.cpp
@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "controllers/commands/builtin/ArianaCommands.hpp"
+
+#include "Application.hpp"
+#include "controllers/commands/CommandContext.hpp"
+#include "providers/kick/KickChannel.hpp"
+#include "providers/twitch/TwitchChannel.hpp"
+#include "singletons/Settings.hpp"
+#include "singletons/WindowManager.hpp"
+#include "widgets/ArianaLounge.hpp"
+#include "widgets/dialogs/SettingsDialog.hpp"
+
+#include <QRandomGenerator>
+
+namespace chatterino::commands {
+
+QString arianaAlbum(const CommandContext &ctx)
+{
+    const QStringList words = ctx.words;
+    if (words.size() < 2)
+    {
+        ctx.channel->addSystemMessage(
+            "Ariana albums: " + ArianaLounge::albumNames().join(", ") +
+            " — use /album <name>");
+        return {};
+    }
+    const QString wanted = words.at(1).toLower();
+    QString match;
+    for (const auto &album : ArianaLounge::albumNames())
+    {
+        if (album.toLower() == wanted ||
+            album.toLower().startsWith(wanted))
+        {
+            match = album;
+            break;
+        }
+    }
+    if (match.isEmpty())
+    {
+        ctx.channel->addSystemMessage(
+            "No Ariana album called \"" + words.at(1) +
+            "\" — albums: " + ArianaLounge::albumNames().join(", "));
+        return {};
+    }
+    ArianaLounge::applyAlbum(match);
+    if (getSettings()->arianaPerChannelAlbumEnabled.getValue())
+    {
+        const QString platform =
+            ctx.twitchChannel != nullptr
+                ? QString("twitch")
+                : (ctx.kickChannel != nullptr ? QString("kick")
+                                              : QString());
+        if (!platform.isEmpty())
+        {
+            ArianaLounge::rememberAlbumForChannel(
+                platform, ctx.channel->getName(), match);
+        }
+    }
+    ctx.channel->addSystemMessage("♡ Ariana album: " + match);
+    return {};
+}
+
+QString arianaLyric(const CommandContext &ctx)
+{
+    const auto lyrics =
+        ArianaLounge::lyricsForAlbum(ArianaLounge::currentAlbum());
+    if (lyrics.isEmpty())
+    {
+        return {};
+    }
+    const QString fragment =
+        lyrics.at(QRandomGenerator::global()->bounded(lyrics.size()));
+    ctx.channel->addSystemMessage("♪ Lyric — \"" + fragment +
+                                  "\" (tap a chip in the ticker bar to "
+                                  "insert it, nothing was sent)");
+    return {};
+}
+
+QString arianaOpenSettings(const CommandContext &ctx)
+{
+    (void)ctx;
+    getApp()->getWindows()->showSettingsDialog(
+        nullptr, SettingsDialogPreference::Ariana);
+    return {};
+}
+
+}  // namespace chatterino::commands
