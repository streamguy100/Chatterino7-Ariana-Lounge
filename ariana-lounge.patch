+
+#pragma once
+
+#include <QPixmap>
+#include <QWidget>
+
+#include <pajlada/signals/signalholder.hpp>
+
+namespace chatterino {
+
+/// Ariana Lounge figure — additive only, Main window only.
+///
+/// Sir's supplied beach photo, background removed, standing at the
+/// bottom-left of the Main window (same spot as his screenshot).
+/// Purely visual: mouse events pass straight through it
+/// (WA_TransparentForMouseEvents), so the chats underneath stay
+/// clickable. Toggleable in Ariana Settings ("Ariana figure"),
+/// default on; hides immediately if the image resource is missing.
+/// The figure herself is untouched — same body, same face as the
+/// photo he sent; only the beach background was removed.
+class ArianaFigure : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit ArianaFigure(QWidget *parent = nullptr);
+
+    /// Show/hide from the arianaFigureEnabled setting (and hide when
+    /// the image is missing). Called on setting change and on
+    /// parent resize.
+    void refresh();
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void refit();
+
+    QPixmap pixmap_;
+    pajlada::Signals::SignalHolder connections_;
+};
+
+}  // namespace chatterino
diff --git a/src/widgets/ArianaLoadingScreen.cpp b/src/widgets/ArianaLoadingScreen.cpp
new file mode 100644
index 000000000..019b31fe6
--- /dev/null
+++ b/src/widgets/ArianaLoadingScreen.cpp
@@ -0,0 +1,128 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "widgets/ArianaLoadingScreen.hpp"
+
+#include <QEvent>
+#include <QPainter>
+#include <QTimer>
+
+namespace chatterino {
+
+namespace {
+
+// Fade timing, exact as sir asked: start at 100% opacity, lose 25%
+// every 1 second, 0% (gone) at 4 seconds.
+constexpr int kFadeStepMs = 1000;
+constexpr int kFadeSteps = 4;
+constexpr qreal kFadeStepOpacity = 0.25;
+
+}  // namespace
+
+ArianaLoadingScreen::ArianaLoadingScreen(QWidget *parent)
+    : QWidget(parent)
+{
+    // Sir's supplied image, embedded by the auto-generated resource
+    // file (everything under resources/ is globbed into
+    // resources_autogenerated.qrc). Byte-identical to the file sir
+    // sent — never regenerated, redrawn, or recoloured.
+    this->pixmap_ = QPixmap(QStringLiteral(":/ariana-loading-screen.jpg"));
+
+    // Never block the chats underneath: clicks pass straight through,
+    // and the widget is purely visual.
+    this->setAttribute(Qt::WA_TransparentForMouseEvents);
+
+    if (parent != nullptr)
+    {
+        parent->installEventFilter(this);
+        this->setGeometry(parent->rect());
+    }
+    this->raise();
+    this->show();
+
+    if (this->pixmap_.isNull())
+    {
+        // Image missing: hide at once instead of showing a black screen.
+        this->finish();
+        return;
+    }
+
+    // Step the fade: 100% -> 75% -> 50% -> 25% -> 0% (gone), one step
+    // every second.
+    this->stepTimer_ = new QTimer(this);
+    QObject::connect(this->stepTimer_, &QTimer::timeout, this,
+                     [this] { this->stepFade(); });
+    this->stepTimer_->start(kFadeStepMs);
+
+    // Hard fallback: gone at 4 seconds no matter what — even if the
+    // step timer stalls, the loading screen can never stick and block
+    // the chats.
+    QTimer::singleShot(kFadeSteps * kFadeStepMs, this,
+                       [this] { this->finish(); });
+}
+
+void ArianaLoadingScreen::paintEvent(QPaintEvent *)
+{
+    QPainter painter(this);
+    painter.fillRect(this->rect(), Qt::black);
+    if (this->pixmap_.isNull())
+    {
+        return;
+    }
+
+    painter.setOpacity(this->opacity_);
+    QPixmap scaled = this->pixmap_.scaled(
+        this->size(), Qt::KeepAspectRatioByExpanding,
+        Qt::SmoothTransformation);
+    int x = (this->width() - scaled.width()) / 2;
+    int y = (this->height() - scaled.height()) / 2;
+    painter.drawPixmap(x, y, scaled);
+}
+
+bool ArianaLoadingScreen::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == this->parentWidget() && event->type() == QEvent::Resize)
+    {
+        // Keep covering the whole window if it is resized while the
+        // loading screen is still fading.
+        this->setGeometry(this->parentWidget()->rect());
+        this->raise();
+    }
+    return QWidget::eventFilter(watched, event);
+}
+
+void ArianaLoadingScreen::stepFade()
+{
+    if (this->finished_)
+    {
+        return;
+    }
+
+    this->step_++;
+    this->opacity_ = 1.0 - (kFadeStepOpacity * this->step_);
+    if (this->step_ >= kFadeSteps)
+    {
+        this->finish();
+        return;
+    }
+    this->update();
+}
+
+void ArianaLoadingScreen::finish()
+{
+    if (this->finished_)
+    {
+        return;
+    }
+    this->finished_ = true;
+
+    if (this->stepTimer_ != nullptr)
+    {
+        this->stepTimer_->stop();
+    }
+    this->hide();
+    this->deleteLater();
+}
+
+}  // namespace chatterino
diff --git a/src/widgets/ArianaLoadingScreen.hpp b/src/widgets/ArianaLoadingScreen.hpp
new file mode 100644
index 000000000..9e2ec9b7e
