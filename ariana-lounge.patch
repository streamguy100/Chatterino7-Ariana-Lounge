+void ArianaLounge::applyAlbum(const QString &album)
+{
+    if (!isAlbum(album))
+    {
+        return;
+    }
+    getSettings()->arianaCurrentAlbum.setValue(album);
+    getTheme()->themeName.setValue(themeKey(album));
+}
+
+QString ArianaLounge::currentAlbum()
+{
+    const QString album = getSettings()->arianaCurrentAlbum.getValue();
+    return isAlbum(album) ? album : QString("Sweetener");
+}
+
+QString ArianaLounge::albumForChannel(const QString &platform,
+                                       const QString &channel)
+{
+    if (platform.isEmpty() || channel.isEmpty())
+    {
+        return {};
+    }
+    const QString key = platform.toLower() + ":" + channel.toLower() + "=";
+    for (const auto &entry :
+         getSettings()->arianaChannelAlbums.getValue().split(';'))
+    {
+        if (entry.startsWith(key))
+        {
+            const QString album = entry.mid(key.size());
+            return isAlbum(album) ? album : QString{};
+        }
+    }
+    return {};
+}
+
+void ArianaLounge::rememberAlbumForChannel(const QString &platform,
+                                           const QString &channel,
+                                           const QString &album)
+{
+    if (platform.isEmpty() || channel.isEmpty() || !isAlbum(album))
+    {
+        return;
+    }
+    const QString key = platform.toLower() + ":" + channel.toLower() + "=";
+    QStringList entries =
+        getSettings()->arianaChannelAlbums.getValue().split(';');
+    entries.removeAll("");
+    bool replaced = false;
+    for (auto &entry : entries)
+    {
+        if (entry.startsWith(key))
+        {
+            entry = key + album;
+            replaced = true;
+        }
+    }
+    if (!replaced)
+    {
+        entries.append(key + album);
+    }
+    getSettings()->arianaChannelAlbums.setValue(entries.join(';'));
+}
+
+bool ArianaLounge::isOwnMessage(const Message &message)
+{
+    // Per-channel account check, same rule as the Fold build: Twitch
+    // account for Twitch, Kick account for Kick, never the other
+    // platform's account, never when logged out / anonymous.
+    if (message.loginName.isEmpty())
+    {
+        return false;
+    }
+    auto *accounts = getApp()->getAccounts();
+    if (accounts == nullptr)
+    {
+        return false;
+    }
+    if (message.platform == MessagePlatform::Kick)
+    {
+        auto kick = accounts->kick.current();
+        return kick != nullptr && !kick->isAnonymous() &&
+               kick->username().compare(message.loginName,
+                                        Qt::CaseInsensitive) == 0;
+    }
+    auto twitch = accounts->twitch.getCurrent();
+    return twitch != nullptr && !twitch->isAnon() &&
+           twitch->getUserName().compare(message.loginName,
+                                         Qt::CaseInsensitive) == 0;
+}
+
+bool ArianaLounge::isBotName(const QString &loginName)
+{
+    const QString lower = loginName.toLower();
+    if (lower.endsWith("bot"))
+    {
+        return true;
+    }
+    static const QStringList knownBots = {
+        "nightbot", "streamelements", "streamlabs", "moobot", "fossabot",
+        "wizebot", "streamkit", "sery_bot", "commanderroot",
+    };
+    return knownBots.contains(lower);
+}
+
+bool ArianaLounge::isModOrVip(const Message &message)
+{
+    for (const auto &badge : message.twitchBadges)
+    {
+        if (badge.key_ == "moderator" || badge.key_ == "vip" ||
+            badge.key_ == "broadcaster")
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool ArianaLounge::quietHoursActive()
+{
+    if (!getSettings()->arianaQuietHoursEnabled.getValue())
+    {
+        return false;
+    }
+    const int start = getSettings()->arianaQuietStart.getValue();
+    const int end = getSettings()->arianaQuietEnd.getValue();
+    if (start == end)
+    {
+        return false;
+    }
+    const int hour = QTime::currentTime().hour();
+    if (start < end)
+    {
+        return hour >= start && hour < end;
+    }
+    return hour >= start || hour < end;
+}
+
+void ArianaLounge::insertIntoSelectedSplit(Window *window,
+                                           const QString &text)
+{
+    if (window == nullptr || text.isEmpty())
+    {
+        return;
+    }
+    auto *page = window->getNotebook().getSelectedPage();
+    if (page == nullptr)
+    {
+        return;
+    }
+    auto *split = page->getSelectedSplit();
+    if (split == nullptr)
+    {
+        return;
+    }
+    // Insert only — SplitInput::insertText never sends.
+    split->getInput().insertText(text);
+}
