diff --git a/src/widgets/ArianaMusic.cpp b/src/widgets/ArianaMusic.cpp
new file mode 100644
index 000000000..b13a9b38d
--- /dev/null
+++ b/src/widgets/ArianaMusic.cpp
@@ -0,0 +1,440 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "widgets/ArianaMusic.hpp"
+
+#include "Application.hpp"
+#include "singletons/Paths.hpp"
+#include "singletons/Settings.hpp"
+
+#include <QAudioOutput>
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QMediaPlayer>
+#include <QPushButton>
+#include <QSlider>
+#include <QTimer>
+#include <QUrl>
+#include <QtGlobal>
+
+namespace chatterino {
+
+namespace {
+
+// 60 seconds per song, then the next song. The trimmed files are
+// already 60 seconds; the cutoff timer below enforces it as well.
+constexpr qint64 kSongLengthMs = 60 * 1000;
+
+const QStringList TITLES = {
+    "bloodline",
+    "Into You",
+    "7 rings",
+    "Dangerous Woman",
+    "34+35",
+};
+
+const QStringList FILES = {
+    "01-bloodline.mp3",
+    "02-into-you.mp3",
+    "03-7-rings.mp3",
+    "04-dangerous-woman.mp3",
+    "05-34-35.mp3",
+};
+
+}  // namespace
+
+QStringList ArianaMusic::songTitles()
+{
+    return TITLES;
+}
+
+QStringList ArianaMusic::songFiles()
+{
+    return FILES;
+}
+
+QString ArianaMusic::musicFolder()
+{
+    return getApp()->getPaths().rootAppDataDirectory + "/ArianaMusic";
+}
+
+ArianaMusic *ArianaMusic::instance()
+{
+    static ArianaMusic *inst =
+        new ArianaMusic(QCoreApplication::instance());
+    return inst;
+}
+
+ArianaMusic::ArianaMusic(QObject *parent)
+    : QObject(parent)
+{
+    this->audio_ = new QAudioOutput(this);
+    this->player_ = new QMediaPlayer(this);
+    this->player_->setAudioOutput(this->audio_);
+
+    this->cutTimer_ = new QTimer(this);
+    this->cutTimer_->setInterval(250);
+    QObject::connect(this->cutTimer_, &QTimer::timeout, this,
+                     [this] { this->checkCutoff(); });
+
+    QObject::connect(
+        this->player_, &QMediaPlayer::mediaStatusChanged, this,
+        [this](QMediaPlayer::MediaStatus status) {
+            // End of a file: move on. The cutoff timer is the 60s
+            // guard; this covers a file shorter than 60 seconds.
+            if (status == QMediaPlayer::EndOfMedia && this->isEnabled())
+            {
+                this->next();
+            }
+        });
+    QObject::connect(
+        this->player_, &QMediaPlayer::playbackStateChanged, this,
+        [this](QMediaPlayer::PlaybackState state) {
+            if (state == QMediaPlayer::PlayingState)
+            {
+                this->cutTimer_->start();
+            }
+            else
+            {
+                this->cutTimer_->stop();
+            }
+            emit this->playingChanged(
+                state == QMediaPlayer::PlayingState);
+        });
+
+    // One volume, two places to change it: both sliders write the
+    // same setting, and this is the only place that applies it to
+    // the audio output, so the bar and the Settings slider can never
+    // drift apart.
+    getSettings()->arianaMusicVolume.connect(
+        [this](const int &value, auto) { this->applyVolume(value); },
+        this->connections_);
+    getSettings()->arianaMusicEnabled.connect(
+        [this](const bool &value, auto) { this->onEnabledChanged(value); },
+        this->connections_);
+}
+
+bool ArianaMusic::hasFiles() const
+{
+    const QString folder = musicFolder();
+    for (const auto &file : FILES)
+    {
+        if (!QFile::exists(folder + "/" + file))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool ArianaMusic::isEnabled() const
+{
+    return getSettings()->arianaMusicEnabled.getValue();
+}
+
+bool ArianaMusic::isPlaying() const
+{
+    return this->player_ != nullptr &&
+           this->player_->playbackState() == QMediaPlayer::PlayingState;
+}
+
+int ArianaMusic::volume() const
+{
+    return getSettings()->arianaMusicVolume.getValue();
+}
+
+QString ArianaMusic::currentTitle() const
+{
+    if (this->currentIndex_ < 0 ||
+        this->currentIndex_ >= TITLES.size())
+    {
+        return {};
+    }
+    return TITLES.at(this->currentIndex_);
+}
+
+void ArianaMusic::startIfEnabled()
+{
+    if (!this->isEnabled() || !this->hasFiles() || this->isPlaying())
+    {
+        return;
+    }
+    this->playCurrent();
+}
+
+void ArianaMusic::setEnabled(bool enabled)
+{
+    getSettings()->arianaMusicEnabled.setValue(enabled);
+}
+
+void ArianaMusic::setVolume(int volume)
+{
+    volume = qBound(0, volume, 100);
+    if (volume == this->volume())
+    {
+        return;
+    }
+    // 0 is mute; sliding back up un-mutes because the volume itself
+    // is the mute state — there is no separate mute flag to forget.
+    getSettings()->arianaMusicVolume.setValue(volume);
+}
+
+void ArianaMusic::applyVolume(int volume)
+{
+    volume = qBound(0, volume, 100);
+    if (this->audio_ != nullptr)
+    {
+        this->audio_->setVolume(static_cast<float>(volume) / 100.F);
+    }
+    emit this->volumeChanged(volume);
+}
+
+void ArianaMusic::onEnabledChanged(bool enabled)
+{
+    // The settings connection fires once when it is first made, with
+    // the stored value. Do not auto-start from that first call: the
+    // Main window calls startIfEnabled() once after layout, and a
+    // later toggle is a real user action.
+    if (!this->settingsReady_)
+    {
+        this->settingsReady_ = true;
+        emit this->enabledChanged(enabled);
+        emit this->availabilityChanged();
+        return;
+    }
+    emit this->enabledChanged(enabled);
+    if (enabled)
+    {
+        if (this->hasFiles())
+        {
+            this->playCurrent();
+        }
+        else
+        {
+            emit this->availabilityChanged();
+        }
+    }
+    else
+    {
+        this->stop();
+    }
+}
+
+void ArianaMusic::playCurrent()
+{
+    if (!this->hasFiles())
+    {
+        emit this->availabilityChanged();
+        return;
+    }
+    const QString path =
+        musicFolder() + "/" + FILES.at(this->currentIndex_);
+    this->player_->setSource(QUrl::fromLocalFile(path));
+    this->player_->play();
+    emit this->trackChanged(this->currentTitle());
+    emit this->availabilityChanged();
+}
+
+void ArianaMusic::checkCutoff()
+{
+    if (!this->isPlaying())
+    {
+        return;
+    }
+    if (this->player_->position() >= kSongLengthMs)
+    {
+        this->next();
+    }
+}
+
+void ArianaMusic::togglePlay()
+{
+    if (!this->isEnabled())
+    {
+        return;
+    }
+    if (this->isPlaying())
+    {
+        this->pause();
+        return;
+    }
+    if (this->player_->playbackState() == QMediaPlayer::PausedState)
+    {
+        this->player_->play();
+        return;
+    }
+    this->playCurrent();
+}
+
+void ArianaMusic::play()
+{
+    if (!this->isEnabled())
+    {
+        return;
+    }
+    if (this->player_->playbackState() == QMediaPlayer::PausedState)
+    {
+        this->player_->play();
+        return;
+    }
+    this->playCurrent();
+}
+
+void ArianaMusic::pause()
+{
+    if (this->player_ != nullptr)
+    {
+        this->player_->pause();
+    }
+}
+
+void ArianaMusic::stop()
+{
+    if (this->player_ != nullptr)
+    {
+        this->player_->stop();
+    }
+}
+
+void ArianaMusic::next()
+{
+    this->currentIndex_ = (this->currentIndex_ + 1) % TITLES.size();
+    if (this->isEnabled())
+    {
+        this->playCurrent();
+    }
+    else
+    {
+        emit this->trackChanged(this->currentTitle());
+    }
+}
+
+void ArianaMusic::prev()
+{
+    this->currentIndex_ =
+        (this->currentIndex_ - 1 + TITLES.size()) % TITLES.size();
+    if (this->isEnabled())
+    {
+        this->playCurrent();
+    }
+    else
+    {
+        emit this->trackChanged(this->currentTitle());
+    }
+}
+
+void ArianaMusic::toggleMute()
+{
+    if (this->volume() == 0)
+    {
+        this->setVolume(this->volumeBeforeMute_ > 0
+                            ? this->volumeBeforeMute_
+                            : 80);
+        return;
+    }
+    this->volumeBeforeMute_ = this->volume();
+    this->setVolume(0);
+}
+
+// ---------------------------------------------------------------------------
+// Music bar
+// ---------------------------------------------------------------------------
+
+ArianaMusicBar::ArianaMusicBar(QWidget *parent)
+    : QWidget(parent)
+{
+    auto *layout = new QHBoxLayout(this);
+    layout->setContentsMargins(6, 2, 6, 2);
+    layout->setSpacing(6);
+
+    auto *music = ArianaMusic::instance();
+
+    auto *prevButton = new QPushButton("Prev", this);
+    QObject::connect(prevButton, &QPushButton::clicked, music,
+                     &ArianaMusic::prev);
+    layout->addWidget(prevButton);
+
+    this->playButton_ = new QPushButton("▶", this);
+    QObject::connect(this->playButton_, &QPushButton::clicked, music,
+                     &ArianaMusic::togglePlay);
+    layout->addWidget(this->playButton_);
+
+    auto *nextButton = new QPushButton("Next", this);
+    QObject::connect(nextButton, &QPushButton::clicked, music,
+                     &ArianaMusic::next);
+    layout->addWidget(nextButton);
+
+    this->muteButton_ = new QPushButton("🔊", this);
+    QObject::connect(this->muteButton_, &QPushButton::clicked, music,
+                     &ArianaMusic::toggleMute);
+    layout->addWidget(this->muteButton_);
+
+    // Same volume as the Ariana Settings slider: both write the one
+    // arianaMusicVolume setting, so they stay in sync.
+    this->volumeSlider_ = new QSlider(Qt::Horizontal, this);
+    this->volumeSlider_->setRange(0, 100);
+    this->volumeSlider_->setValue(music->volume());
+    this->volumeSlider_->setToolTip("Background music volume");
+    QObject::connect(this->volumeSlider_, &QSlider::valueChanged, music,
+                     &ArianaMusic::setVolume);
+    layout->addWidget(this->volumeSlider_, 1);
+
+    this->nowLabel_ = new QLabel(this);
+    layout->addWidget(this->nowLabel_, 2);
+
+    QObject::connect(music, &ArianaMusic::playingChanged, this,
+                     [this] { this->refresh(); });
+    QObject::connect(music, &ArianaMusic::trackChanged, this,
+                     [this] { this->refresh(); });
+    QObject::connect(music, &ArianaMusic::availabilityChanged, this,
+                     [this] { this->refresh(); });
+    QObject::connect(music, &ArianaMusic::volumeChanged, this,
+                     [this](int volume) {
+                         if (this->volumeSlider_ != nullptr &&
+                             this->volumeSlider_->value() != volume)
+                         {
+                             this->volumeSlider_->setValue(volume);
+                         }
+                         this->refresh();
+                     });
+
+    this->refresh();
+}
+
+void ArianaMusicBar::refresh()
+{
+    auto *music = ArianaMusic::instance();
+    const bool files = music->hasFiles();
+    if (this->playButton_ != nullptr)
+    {
+        this->playButton_->setEnabled(files);
+        this->playButton_->setText(music->isPlaying() ? "❚❚" : "▶");
+    }
+    if (this->muteButton_ != nullptr)
+    {
+        this->muteButton_->setText(music->volume() == 0 ? "🔇" : "🔊");
+    }
+    if (this->nowLabel_ != nullptr)
+    {
+        if (!files)
+        {
+            this->nowLabel_->setText(
+                "Add your 5 songs to the ArianaMusic folder");
+        }
+        else if (music->isPlaying())
+        {
+            this->nowLabel_->setText("♪ " + music->currentTitle());
+        }
+        else
+        {
+            this->nowLabel_->setText("♪ " + music->currentTitle() +
+                                     " — paused");
+        }
+    }
+}
+
+}  // namespace chatterino
