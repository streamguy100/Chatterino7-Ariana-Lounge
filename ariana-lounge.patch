+QString ArianaLounge::countdownText()
+{
+    const QDate today = QDate::currentDate();
+    // Ariana birthday June 26, then the next album anniversary.
+    const QList<QPair<QDate, QString>> dates = {
+        {QDate(today.year(), 6, 26), "Ariana's birthday"},
+        {QDate(today.year(), 8, 17), "Sweetener"},
+        {QDate(today.year(), 2, 8), "Thank U, Next"},
+        {QDate(today.year(), 10, 30), "Positions"},
+        {QDate(today.year(), 3, 8), "Eternal Sunshine"},
+    };
+    int bestDays = -1;
+    QString bestLabel;
+    for (const auto &[date, label] : dates)
+    {
+        QDate next = date;
+        if (next < today)
+        {
+            next = next.addYears(1);
+        }
+        int days = today.daysTo(next);
+        if (bestDays < 0 || days < bestDays)
+        {
+            bestDays = days;
+            bestLabel = label;
+        }
+    }
+    if (bestDays == 0)
+    {
+        return "♡ " + bestLabel + " — today!";
+    }
+    return "♡ " + bestLabel + " in " + QString::number(bestDays) + "d";
+}
