+void Window::arianaSetFocusMode(bool enabled)
+{
+    // Focus mode (opt-in): only the selected split keeps scrolling
+    // live; every other split is paused with the stock ChannelView
+    // pause (the same pause Space uses). Turning it off unpauses them.
+    // No split is moved, closed, or rewired.
+    getSettings()->arianaFocusModeEnabled.setValue(enabled);
+    if (enabled)
+    {
+        getSettings()->arianaGridModeEnabled.setValue(false);
+    }
+    auto *page = this->notebook_->getSelectedPage();
+    if (page == nullptr)
+    {
+        return;
+    }
+    auto *selected = page->getSelectedSplit();
+    for (auto *split : page->getSplits())
+    {
+        if (split == nullptr)
+        {
+            continue;
+        }
+        if (enabled && split != selected)
+        {
+            split->getChannelView().pause(PauseReason::Mouse);
+        }
+        else
+        {
+            split->getChannelView().unpause(PauseReason::Mouse);
+        }
+    }
+    this->arianaRefreshBars();
+}
+
+void Window::arianaSetGridMode(bool enabled)
+{
+    // Grid mode (opt-in, simplified): the focused tile stays live and
+    // the other tiles pause, exactly like focus mode. The tiles
+    // themselves stay in their stock split layout — rearranging
+    // SplitContainer nodes would rewire stock behaviour, so the grid
+    // size setting only labels the mode (2x2 / 3x3) and the pause rule
+    // is what actually runs.
+    getSettings()->arianaGridModeEnabled.setValue(enabled);
+    if (enabled)
+    {
+        getSettings()->arianaFocusModeEnabled.setValue(false);
+    }
+    auto *page = this->notebook_->getSelectedPage();
+    if (page == nullptr)
+    {
+        return;
+    }
+    auto *selected = page->getSelectedSplit();
+    for (auto *split : page->getSplits())
+    {
+        if (split == nullptr)
+        {
+            continue;
+        }
+        if (enabled && split != selected)
+        {
+            split->getChannelView().pause(PauseReason::Mouse);
+        }
+        else
+        {
+            split->getChannelView().unpause(PauseReason::Mouse);
+        }
+    }
+    this->arianaRefreshBars();
+}
+
+void Window::arianaFixResize()
+{
+    // Resize must work in both directions. Chatterino's custom Windows
+    // frame (BaseWindow::handleNCHITTEST) only offers an edge when
+    // minimum != maximum on that axis, so keep both axes explicitly
+    // free: a small minimum, no maximum.
+    this->setMinimumSize(300, 200);
+    this->setMaximumSize(QWIDGETSIZE_MAX, QWIDGETSIZE_MAX);
+    this->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+}
+
+void Window::arianaSetMiniMode(bool enabled)
+{
+    // Mini mode (opt-in): compact narrow window for a second monitor,
+    // ticker + chips hidden to save space. Only this window's size and
+    // the Ariana bars change; chats keep working.
+    getSettings()->arianaMiniModeEnabled.setValue(enabled);
+    if (enabled)
+    {
+        this->arianaPreMiniSize_ = this->size();
+        this->resize(380, 700);
+    }
+    else if (!this->arianaPreMiniSize_.isEmpty())
+    {
+        this->resize(this->arianaPreMiniSize_);
+    }
+    this->arianaFixResize();
+    this->arianaRefreshBars();
+}
+
+void Window::addArianaShortcuts()
+{
+    // Alt+1..9 switch album, Alt+L ticker, Alt+C chips, Alt+S
+    // sparkles. Plain QShortcuts on the Main window only — they do not
+    // replace or rebind any stock hotkey (stock tabs use Ctrl+1-8).
+    if (this->type_ != WindowType::Main)
+    {
+        return;
+    }
+    const auto albums = ArianaLounge::albumNames();
+    for (int i = 0; i < albums.size(); i++)
+    {
+        auto *shortcut = new QShortcut(
+            QKeySequence("Alt+" + QString::number(i + 1)), this);
+        const QString album = albums.at(i);
+        QObject::connect(shortcut, &QShortcut::activated, this,
+                         [album] { ArianaLounge::applyAlbum(album); });
+    }
+    auto *tickerShortcut = new QShortcut(QKeySequence("Alt+L"), this);
+    QObject::connect(tickerShortcut, &QShortcut::activated, this, [] {
+        auto *settings = getSettings();
+        settings->arianaTickerEnabled.setValue(
+            !settings->arianaTickerEnabled.getValue());
+    });
+    auto *chipsShortcut = new QShortcut(QKeySequence("Alt+C"), this);
+    QObject::connect(chipsShortcut, &QShortcut::activated, this, [] {
+        auto *settings = getSettings();
+        settings->arianaChipsEnabled.setValue(
+            !settings->arianaChipsEnabled.getValue());
+    });
+    auto *sparklesShortcut = new QShortcut(QKeySequence("Alt+S"), this);
+    QObject::connect(sparklesShortcut, &QShortcut::activated, this, [] {
+        auto *settings = getSettings();
+        settings->arianaSparklesEnabled.setValue(
+            !settings->arianaSparklesEnabled.getValue());
+    });
+}
