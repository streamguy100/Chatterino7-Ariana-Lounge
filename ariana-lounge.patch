+#pragma once
+
+#include <QString>
+#include <QStringList>
+#include <QWidget>
+
+namespace chatterino {
+
+class Window;
+struct Message;
+
+/// Ariana Lounge — additive-only revamp on top of stock Chatterino7.
+///
+/// HARD RULE: stock Chatterino7 behaviour is never changed or rewired
+/// here. Everything in this file is an addition: a shelf, a ticker, chips
+/// that INSERT text (never auto-send), a settings page, and row tints.
+/// Every extra is toggleable, grid/focus/mini are opt-in, and if an extra
+/// would change a stock behaviour it is dropped or simplified instead.
+/// No new login, no OAuth, no photo/face, no album artwork — colours and
+/// short lyric fragments (text only) only.
+class ArianaLounge
+{
+public:
+    static QStringList albumNames();
+    static QString themeKey(const QString &album);
+    static bool isAlbum(const QString &album);
+
+    /// Short public lyric fragments per album (text only, no audio).
+    static QStringList lyricsForAlbum(const QString &album);
+    static QStringList allLyrics();
+    static bool isLyricText(const QString &text);
+
+    /// Quick-send phrases (insert only) and reaction row.
+    static QStringList phrases();
+    static QStringList reactions();
+    /// Well-known global emote shortcodes, inserted as plain text and
+    /// rendered by the stock emote providers when sent.
+    static QStringList emoteShortcodes();
+
+    static QString countdownText();
+    static QString startupQuote();
+    static QString spotifyHubUrl();
+
+    /// Switch the app theme to an album. Theme only — no channel, account
+    /// or chat state is touched.
+    static void applyAlbum(const QString &album);
+    static QString currentAlbum();
+
+    /// Per-channel album memory, kept in one settings string as
+    /// "twitch:channel=Album;kick:channel=Album;". Twitch and Kick are
+    /// stored separately so one never leaks into the other.
+    static QString albumForChannel(const QString &platform,
+                                   const QString &channel);
+    static void rememberAlbumForChannel(const QString &platform,
+                                        const QString &channel,
+                                        const QString &album);
+
+    /// True when the message was sent by the account connected for THIS
+    /// message's channel (Twitch account for Twitch, Kick account for
+    /// Kick). Logged-out / anonymous accounts never match.
+    static bool isOwnMessage(const Message &message);
+    static bool isBotName(const QString &loginName);
+    static bool isModOrVip(const Message &message);
+
+    static bool quietHoursActive();
+
+    /// Insert text into the selected split's input box. Insert only —
+    /// nothing is ever sent from here.
+    static void insertIntoSelectedSplit(Window *window, const QString &text);
+};
+
+/// Left album shelf (Main window only). Album buttons switch the theme
+/// live, no restart. Mini / Focus / Grid buttons only call back into
+/// Window, which owns the splits — this widget never touches a split.
+class ArianaShelf : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit ArianaShelf(Window *window, QWidget *parent = nullptr);
+
+    void refresh();
+
+private:
+    void applySchedulerTick();
+
+    Window *window_;
+    class QLabel *countdownLabel_ = nullptr;
+    class QTimer *schedulerTimer_ = nullptr;
+};
+
+/// Lyrics ticker + quick chips + reactions + emote shortcodes, above the
+/// input (Main window only). Ticker is text only and rotates on a timer;
+/// chips insert into the selected split's input, never auto-send.
+class ArianaTickerBar : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit ArianaTickerBar(Window *window, QWidget *parent = nullptr);
+
+    void refresh();
+
+private:
+    void rotateTicker();
+
+    Window *window_;
+    class QLabel *tickerLabel_ = nullptr;
+    class QPushButton *starButton_ = nullptr;
+    class QWidget *chipsRow_ = nullptr;
+    class QTimer *tickerTimer_ = nullptr;
+    int tickerIndex_ = 0;
+};
+
+}  // namespace chatterino
