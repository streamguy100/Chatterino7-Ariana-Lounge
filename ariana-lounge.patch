+ArianaShelf::ArianaShelf(Window *window, QWidget *parent)
+    : QWidget(parent)
+    , window_(window)
+{
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(4, 6, 4, 6);
+    layout->setSpacing(4);
+
+    auto *title = new QLabel("♡ ARIANA", this);
+    title->setStyleSheet("font-weight: bold;");
+    layout->addWidget(title);
+
+    const QList<QPair<QString, QString>> buttons = {
+        {"Sweetener", "Sweetener"}, {"Positions", "Positions"},
+        {"Eternal", "EternalSunshine"}, {"7 Rings", "7Rings"},
+        {"Thank U, Next", "ThankUNext"}, {"Dangerous", "DangerousWoman"},
+        {"Yours Truly", "YoursTruly"}, {"My Everything", "MyEverything"},
+        {"Xmas & Chill", "ChristmasAndChill"},
+    };
+    for (const auto &[label, album] : buttons)
+    {
+        auto *button = new QPushButton(label, this);
+        QObject::connect(button, &QPushButton::clicked, this, [album] {
+            ArianaLounge::applyAlbum(album);
+        });
+        layout->addWidget(button);
+    }
+
+    auto *miniButton = new QPushButton("Mini", this);
+    QObject::connect(miniButton, &QPushButton::clicked, this, [this] {
+        this->window_->arianaSetMiniMode(
+            !getSettings()->arianaMiniMode.getValue());
+    });
+    layout->addWidget(miniButton);
+
+    auto *focusButton = new QPushButton("Focus", this);
+    QObject::connect(focusButton, &QPushButton::clicked, this, [this] {
+        this->window_->arianaSetFocusMode(
+            !getSettings()->arianaFocusMode.getValue());
+    });
+    layout->addWidget(focusButton);
+
+    auto *gridButton = new QPushButton("Grid", this);
+    QObject::connect(gridButton, &QPushButton::clicked, this, [this] {
+        this->window_->arianaSetGridMode(
+            !getSettings()->arianaGridMode.getValue());
+    });
+    layout->addWidget(gridButton);
+
+    auto *spotifyButton = new QPushButton("♪ Ariana hub", this);
+    QObject::connect(spotifyButton, &QPushButton::clicked, this, [] {
+        QDesktopServices::openUrl(QUrl(ArianaLounge::spotifyHubUrl()));
+    });
+    layout->addWidget(spotifyButton);
+
+    this->countdownLabel_ = new QLabel(this);
+    this->countdownLabel_->setWordWrap(true);
+    layout->addWidget(this->countdownLabel_);
+
+    layout->addStretch();
+
+    this->schedulerTimer_ = new QTimer(this);
+    this->schedulerTimer_->setInterval(60 * 1000);
+    QObject::connect(this->schedulerTimer_, &QTimer::timeout, this,
+                     [this] { this->applySchedulerTick(); });
+    this->schedulerTimer_->start();
+
+    this->refresh();
+}
+
+void ArianaShelf::refresh()
+{
+    const bool showShelf = getSettings()->arianaShelfEnabled.getValue();
+    this->setVisible(showShelf);
+    if (this->countdownLabel_ != nullptr)
+    {
+        this->countdownLabel_->setVisible(
+            getSettings()->arianaCountdownEnabled.getValue());
+        this->countdownLabel_->setText(ArianaLounge::countdownText());
+    }
+}
+
+void ArianaShelf::applySchedulerTick()
+{
+    if (!getSettings()->arianaSchedulerEnabled.getValue())
+    {
+        return;
+    }
+    const int hour = QTime::currentTime().hour();
+    const QString album =
+        hour < 12 ? getSettings()->arianaMorningAlbum.getValue()
+        : hour < 18 ? getSettings()->arianaAfternoonAlbum.getValue()
+                    : getSettings()->arianaNightAlbum.getValue();
+    if (isAlbum(album) && album != currentAlbum())
+    {
+        applyAlbum(album);
+    }
+}
