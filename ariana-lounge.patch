+
+ArianaTickerBar::ArianaTickerBar(Window *window, QWidget *parent)
+    : QWidget(parent)
+    , window_(window)
+{
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(4, 2, 4, 2);
+    layout->setSpacing(2);
+
+    auto *tickerRow = new QWidget(this);
+    auto *tickerLayout = new QHBoxLayout(tickerRow);
+    tickerLayout->setContentsMargins(0, 0, 0, 0);
+    this->tickerLabel_ = new QLabel(tickerRow);
+    tickerLayout->addWidget(this->tickerLabel_, 1);
+    this->starButton_ = new QPushButton("☆ fav", tickerRow);
+    QObject::connect(this->starButton_, &QPushButton::clicked, this,
+                     [this] {
+                         // Star the lyric on screen now: it pins first in
+                         // the rotation until unstarred.
+                         const QString current = this->tickerLabel_->text();
+                         auto *settings = getSettings();
+                         if (settings->arianaFavouriteLyric.getValue() ==
+                             current)
+                         {
+                             settings->arianaFavouriteLyric.setValue(
+                                 QString());
+                         }
+                         else
+                         {
+                             settings->arianaFavouriteLyric.setValue(current);
+                         }
+                         this->refresh();
+                     });
+    tickerLayout->addWidget(this->starButton_);
+    layout->addWidget(tickerRow);
+
+    this->chipsRow_ = new QWidget(this);
+    auto *chipsLayout = new QHBoxLayout(this->chipsRow_);
+    chipsLayout->setContentsMargins(0, 0, 0, 0);
+    for (const auto &phrase : ArianaLounge::phrases())
+    {
+        auto *chip = new QPushButton(phrase, this->chipsRow_);
+        QObject::connect(chip, &QPushButton::clicked, this,
+                         [this, phrase] {
+                             ArianaLounge::insertIntoSelectedSplit(
+                                 this->window_, phrase + " ");
+                         });
+        chipsLayout->addWidget(chip);
+    }
+    for (const auto &reaction : ArianaLounge::reactions())
+    {
+        auto *chip = new QPushButton(reaction, this->chipsRow_);
+        QObject::connect(chip, &QPushButton::clicked, this,
+                         [this, reaction] {
+                             ArianaLounge::insertIntoSelectedSplit(
+                                 this->window_, reaction + " ");
+                         });
+        chipsLayout->addWidget(chip);
+    }
+    for (const auto &emote : ArianaLounge::emoteShortcodes())
+    {
+        auto *chip = new QPushButton(emote, this->chipsRow_);
+        QObject::connect(chip, &QPushButton::clicked, this,
+                         [this, emote] {
+                             ArianaLounge::insertIntoSelectedSplit(
+                                 this->window_, emote + " ");
+                         });
+        chipsLayout->addWidget(chip);
+    }
+    layout->addWidget(this->chipsRow_);
+
+    this->tickerTimer_ = new QTimer(this);
+    this->tickerTimer_->setInterval(8000);
+    QObject::connect(this->tickerTimer_, &QTimer::timeout, this,
+                     [this] { this->rotateTicker(); });
+    this->tickerTimer_->start();
+
+    this->refresh();
+}
+
+void ArianaTickerBar::refresh()
+{
+    const bool mini = getSettings()->arianaMiniModeEnabled.getValue();
+    const bool showTicker =
+        !mini && getSettings()->arianaTickerEnabled.getValue();
+    const bool showChips =
+        !mini && getSettings()->arianaChipsEnabled.getValue();
+    if (this->tickerLabel_ != nullptr)
+    {
+        this->tickerLabel_->parentWidget()->setVisible(showTicker);
+    }
+    if (this->chipsRow_ != nullptr)
+    {
+        this->chipsRow_->setVisible(showChips);
+    }
+    this->setVisible(showTicker || showChips);
+    this->rotateTicker();
+}
+
+void ArianaTickerBar::rotateTicker()
+{
+    if (this->tickerLabel_ == nullptr)
+    {
+        return;
+    }
+    if (ArianaLounge::quietHoursActive())
+    {
+        this->tickerLabel_->setText("☁ quiet hours — ticker paused");
+        return;
+    }
+    const QString favourite =
+        getSettings()->arianaFavouriteLyric.getValue();
+    if (!favourite.isEmpty())
+    {
+        this->tickerLabel_->setText("★ " + favourite);
+        return;
+    }
+    const auto lyrics =
+        ArianaLounge::lyricsForAlbum(ArianaLounge::currentAlbum());
+    if (lyrics.isEmpty())
+    {
+        return;
+    }
+    this->tickerIndex_ = (this->tickerIndex_ + 1) % lyrics.size();
+    this->tickerLabel_->setText("♪ " + lyrics.at(this->tickerIndex_));
+}
+
+}  // namespace chatterino
