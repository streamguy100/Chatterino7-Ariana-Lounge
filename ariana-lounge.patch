new file mode 100644
index 000000000..5a143bf8c
--- /dev/null
+++ b/src/widgets/ArianaFigure.cpp
@@ -0,0 +1,106 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "widgets/ArianaFigure.hpp"
+
+#include "singletons/Settings.hpp"
+
+#include <QEvent>
+#include <QPainter>
+#include <QtGlobal>
+
+namespace chatterino {
+
+namespace {
+
+// Height of the figure on screen (the PNG itself is 600 tall, so it
+// stays crisp at this size). The bottom margin puts her feet just
+// above the input / chips rows at the bottom of the window, like
+// sir's screenshot.
+constexpr int kFigureHeight = 300;
+constexpr int kBottomMargin = 100;
+constexpr int kLeftMargin = 8;
+
+}  // namespace
+
+ArianaFigure::ArianaFigure(QWidget *parent)
+    : QWidget(parent)
+{
+    // Sir's supplied image, background removed, embedded by the
+    // auto-generated resource file (everything under resources/ is
+    // globbed into resources_autogenerated.qrc).
+    this->pixmap_ = QPixmap(QStringLiteral(":/ariana_figure.png"));
+
+    // Never block the chats underneath: clicks pass straight through,
+    // and the widget is purely visual.
+    this->setAttribute(Qt::WA_TransparentForMouseEvents);
+
+    if (parent != nullptr)
+    {
+        parent->installEventFilter(this);
+    }
+
+    // Live toggle: the Ariana Settings checkbox writes this setting,
+    // and the figure shows/hides at once, no restart.
+    getSettings()->arianaFigureEnabled.connect(
+        [this](const bool &value, auto) { this->refresh(); },
+        this->connections_);
+
+    this->refit();
+    this->refresh();
+}
+
+void ArianaFigure::paintEvent(QPaintEvent *)
+{
+    if (this->pixmap_.isNull())
+    {
+        return;
+    }
+    QPainter painter(this);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform);
+    painter.drawPixmap(this->rect(), this->pixmap_);
+}
+
+bool ArianaFigure::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == this->parentWidget() && event->type() == QEvent::Resize)
+    {
+        // Keep her bottom-left if the window is resized.
+        this->refit();
+    }
+    return QWidget::eventFilter(watched, event);
+}
+
+void ArianaFigure::refresh()
+{
+    const bool show = !this->pixmap_.isNull() &&
+                      getSettings()->arianaFigureEnabled.getValue();
+    this->setVisible(show);
+    if (show)
+    {
+        this->raise();
+    }
+}
+
+void ArianaFigure::refit()
+{
+    auto *parent = this->parentWidget();
+    if (parent == nullptr || this->pixmap_.isNull())
+    {
+        return;
+    }
+    int height = kFigureHeight;
+    const int maxHeight = parent->height() - kBottomMargin - kLeftMargin;
+    if (height > maxHeight)
+    {
+        height = qMax(120, maxHeight);
+    }
+    const int width =
+        height * this->pixmap_.width() / this->pixmap_.height();
+    this->setGeometry(kLeftMargin,
+                      parent->height() - kBottomMargin - height, width,
+                      height);
+}
+
+}  // namespace chatterino
