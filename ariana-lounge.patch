+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <QStringList>
+#include <QWidget>
+
+#include <pajlada/signals/signalholder.hpp>
+
+class QAudioOutput;
+class QMediaPlayer;
+class QTimer;
+
+namespace chatterino {
+
+/// Ariana Lounge background music — additive only, default OFF.
+///
+/// HARD RULE: stock Chatterino 7TV behaviour is never changed here. The
+/// player only reads the user's OWN mp3 files from the ArianaMusic
+/// folder under the app data directory (%APPDATA%\Chatterino2 on
+/// Windows). No songs are bundled in the patch, the repo, or the exe.
+/// Song titles only — no other text is shown for a song.
+/// One volume, two places to change it: the music bar slider and the
+/// Ariana Settings slider both write the same setting, so they are
+/// always in sync. 0 is mute; sliding back up un-mutes.
+class ArianaMusic : public QObject
+{
+    Q_OBJECT
+
+public:
+    /// 5 songs, in the order sir gave them. Each file is the trimmed
+    /// 1-minute version; playback is also cut at 60 seconds so a full
+    /// file can never play past 60 seconds.
+    static QStringList songTitles();
+    static QStringList songFiles();
+
+    /// %APPDATA%\Chatterino2\ArianaMusic on Windows (the app data
+    /// directory + "/ArianaMusic" everywhere else).
+    static QString musicFolder();
+
+    static ArianaMusic *instance();
+
+    bool hasFiles() const;
+    bool isEnabled() const;
+    bool isPlaying() const;
+    int volume() const;
+    QString currentTitle() const;
+
+    /// Start playing if music is enabled and the files are present.
+    /// Called once by the Main window after layout; does nothing when
+    /// music is off or the files are missing.
+    void startIfEnabled();
+
+public slots:
+    void setEnabled(bool enabled);
+    void setVolume(int volume);
+    void togglePlay();
+    void play();
+    void pause();
+    void stop();
+    void next();
+    void prev();
+    void toggleMute();
+
+signals:
+    void enabledChanged(bool enabled);
+    void volumeChanged(int volume);
+    void trackChanged(const QString &title);
+    void playingChanged(bool playing);
+    void availabilityChanged();
+
+private:
+    explicit ArianaMusic(QObject *parent = nullptr);
+
+    void playCurrent();
+    void applyVolume(int volume);
+    void onEnabledChanged(bool enabled);
+    void checkCutoff();
+
+    QMediaPlayer *player_ = nullptr;
+    QAudioOutput *audio_ = nullptr;
+    QTimer *cutTimer_ = nullptr;
+    int currentIndex_ = 0;
+    int volumeBeforeMute_ = 80;
+    bool settingsReady_ = false;
+
+    pajlada::Signals::SignalHolder connections_;
+};
+
+/// Small music bar (Main window only). Play / Pause, Prev, Next, Mute,
+/// a volume slider and the Now Playing title — titles only. Hidden
+/// entirely while background music is off, so the stock look is
+/// unchanged by default.
+class ArianaMusicBar : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit ArianaMusicBar(QWidget *parent = nullptr);
+
+    void refresh();
+
+private:
+    class QPushButton *playButton_ = nullptr;
+    class QPushButton *muteButton_ = nullptr;
+    class QSlider *volumeSlider_ = nullptr;
+    class QLabel *nowLabel_ = nullptr;
+};
+
+}  // namespace chatterino
